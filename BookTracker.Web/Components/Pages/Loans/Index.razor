@page "/loans"
@using BookTracker.Application.Loans
@inject LoansViewModel VM
@inject LendDialogViewModel LendVM
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IBrowserViewportService Viewport

<PageTitle>On loan - Bookcase</PageTitle>

@* Books currently lent out, grouped by borrower, with the returned-loan
   history below. One card-row layout at every width (the Library's mobile
   card pattern), so the page reads the same on a phone and a desktop. *@

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-3">

    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h4" Class="flex-grow-1">On loan</MudText>
        <MudButton OnClick="OpenLendDialogAsync"
                   Disabled="@_dialogOpening"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Outbox">
            Lend a book
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrEmpty(VM.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error"
                  ShowCloseIcon="true"
                  CloseIconClicked="@(() => { VM.ErrorMessage = null; StateHasChanged(); })"
                  Class="mb-3">@VM.ErrorMessage</MudAlert>
    }

    @if (!VM.Loaded)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-5">
            <MudProgressCircular Indeterminate="true" />
        </MudStack>
    }
    else if (VM.Groups.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="pt-3">Nothing is out on loan.</MudText>
        <MudText Color="Color.Secondary" Class="pb-3">
            To lend a book, use the Lend a book button above: choose the book, then enter who is borrowing it. You can also press Lend on a book's own page.
        </MudText>
    }
    else
    {
        @foreach (var group in VM.Groups)
        {
            <MudPaper Elevation="1" Class="pa-3 mb-3">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
                    <MudText Typo="Typo.h6">@group.BorrowerName</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@BookCountLabel(group.Loans.Count)</MudChip>
                    @if (group.Loans.Any(l => l.DueOn is not null))
                    {
                        <MudSpacer />
                        @* download keeps Blazor's router from intercepting the link;
                           the file name comes from the response's Content-Disposition. *@
                        <MudButton Href="@($"/api/loans/calendar.ics?borrower={Uri.EscapeDataString(group.BorrowerName)}")"
                                   download=""
                                   Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Event">
                            Add all to calendar
                        </MudButton>
                    }
                </MudStack>
                @foreach (var loan in group.Loans)
                {
                    <div class="book-card-mobile d-flex gap-3 align-items-start">
                        <a href="@($"/books/{loan.BookId}")" class="flex-shrink-0">
                            @if (!string.IsNullOrWhiteSpace(loan.CoverUrl))
                            {
                                <img src="@loan.CoverUrl" alt="" loading="lazy" decoding="async" class="rounded" style="width: 48px; height: 68px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 68px; background: rgba(0,0,0,0.05);">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">--</MudText>
                                </div>
                            }
                        </a>
                        <div class="flex-grow-1 min-width-0">
                            <MudLink Href="@($"/books/{loan.BookId}")" Underline="Underline.Hover" Color="Color.Inherit"
                                     Style="font-weight: 500;">@loan.Title</MudLink>
                            @if (!string.IsNullOrWhiteSpace(loan.Author))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@loan.Author</MudText>
                            }
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">since @loan.LentOn.ToString("d MMM yyyy")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">·</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@DueLabel(loan)</MudText>
                                @if (VM.IsOverdue(loan))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Overdue</MudChip>
                                }
                            </MudStack>
                        </div>
                        @if (loan.DueOn is not null)
                        {
                            <MudTooltip Text="Add to calendar">
                                <MudIconButton Href="@($"/api/loans/{loan.LoanId}/calendar.ics")"
                                               download="@($"loan-{loan.LoanId}.ics")"
                                               Icon="@Icons.Material.Filled.Event"
                                               Color="Color.Primary" Size="Size.Small" Class="flex-shrink-0"
                                               aria-label="@($"Add the return of {loan.Title} to your calendar")" />
                            </MudTooltip>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="flex-shrink-0"
                                   Disabled="@VM.ReturningLoanIds.Contains(loan.LoanId)"
                                   OnClick="@(() => VM.ReturnAsync(loan.LoanId))">
                            Returned
                        </MudButton>
                    </div>
                }
            </MudPaper>
        }
    }

    <MudExpansionPanels Elevation="1" Class="mt-4">
        <MudExpansionPanel @bind-Expanded:get="_historyOpen" @bind-Expanded:set="OnHistoryExpandedChanged">
            <TitleContent>
                <MudText Typo="Typo.h6">History</MudText>
            </TitleContent>
            <ChildContent>
                @if (!VM.HistoryLoaded)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="py-3">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    </MudStack>
                }
                else if (VM.History.Count == 0)
                {
                    <MudText Color="Color.Secondary">No returned loans yet.</MudText>
                }
                else
                {
                    @foreach (var row in VM.History)
                    {
                        <div class="book-card-mobile">
                            <MudLink Href="@($"/books/{row.BookId}")" Underline="Underline.Hover" Color="Color.Inherit"
                                     Style="font-weight: 500;">@row.Title</MudLink>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@row.BorrowerName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                lent @row.LentOn.ToString("d MMM yyyy") · returned @row.ReturnedOn.ToString("d MMM yyyy")
                            </MudText>
                        </div>
                    }
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

</MudContainer>

@code {
    private bool _historyOpen;
    private bool _dialogOpening;

    protected override Task OnInitializedAsync() => VM.LoadAsync();

    // The page's own LendDialogViewModel, started empty: the dialog's book
    // search picks the copies. Full screen on a phone-width viewport.
    private async Task OpenLendDialogAsync()
    {
        if (_dialogOpening) return;
        _dialogOpening = true;
        try
        {
            LendVM.Initialize();
            var parameters = new DialogParameters<LendDialog> { { x => x.VM, LendVM } };
            var breakpoint = await Viewport.GetCurrentBreakpointAsync();
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = true,
                FullScreen = breakpoint == Breakpoint.Xs,
            };
            var dialog = await DialogService.ShowAsync<LendDialog>("Lend", parameters, options);
            var result = await dialog.Result;
            if (result is not null && !result.Canceled)
            {
                Snackbar.Add(LendVM.LentMessage, Severity.Success);
                await VM.LoadAsync();
            }
        }
        finally
        {
            _dialogOpening = false;
        }
    }

    private async Task OnHistoryExpandedChanged(bool expanded)
    {
        _historyOpen = expanded;
        if (expanded) await VM.EnsureHistoryLoadedAsync();
    }

    private static string DueLabel(OpenLoanRow loan) =>
        loan.DueOn is { } due ? $"due {due:d MMM yyyy}" : "no return date";

    private static string BookCountLabel(int count) => count == 1 ? "1 book" : $"{count} books";
}
