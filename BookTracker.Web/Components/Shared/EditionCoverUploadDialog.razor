@* Modal dialog for uploading a user-supplied cover photo for a specific
   Edition. Used for rare / old editions where no online cover exists. The
   photo is taken or chosen and cropped by CoverPhotoPicker; the upload then
   goes through the page's BookDetailViewModel (passed in as a parameter) so
   post-upload state refresh is centralised — the VM persists Edition.CoverUrl
   + IsUserSupplied and re-loads the page's snapshot in one step. *@

@using BookTracker.Web.Services.Covers
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width: 280px;">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Take or choose a photo of this edition's cover, then crop it. Mobile users get the rear camera by default.
            </MudText>
            <CoverPhotoPicker @bind-Photo="photo" />
        </MudStack>
        <ActionError Message="@ViewModel.Error" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@uploading">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="UploadAsync"
                   Disabled="@(photo is null || uploading)">
            @if (uploading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                <span>Uploading...</span>
            }
            else
            {
                <span>Upload</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public int EditionId { get; set; }
    [Parameter, EditorRequired] public BookDetailViewModel ViewModel { get; set; } = default!;

    private CoverPhoto? photo;
    private bool uploading;

    private async Task UploadAsync()
    {
        if (photo is null) return;
        uploading = true;
        try
        {
            var result = await ViewModel.UploadEditionCoverAsync(EditionId, photo, CancellationToken.None);
            if (result.Success)
            {
                Snackbar.Add("Cover photo uploaded.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }
            ViewModel.Error = result.ErrorMessage ?? "Upload failed.";
        }
        finally
        {
            uploading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
