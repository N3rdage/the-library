@* Short in-page help note opened from the ? button beside a page title. Pure
   static text: no ViewModel, no dispatch. The closing link goes to the manual
   section; the app has <base href="/">, so the href is "manual#id", never a bare
   "#id". *@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="max-width: 460px;">
            @foreach (var paragraph in Paragraphs(Topic))
            {
                <MudText Typo="Typo.body2">@paragraph</MudText>
            }
            <MudText Typo="Typo.body2">
                For more, see <MudLink Href="@ManualHref(Topic)">@ManualLabel(Topic)</MudLink> in the manual.
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public HelpTopic Topic { get; set; }

    private void Close() => MudDialog.Close();

    public static string TitleFor(HelpTopic topic) => topic switch
    {
        HelpTopic.SeriesOrder => "Series order",
        HelpTopic.AddBook => "Adding a book",
        HelpTopic.BulkAdd => "Bulk add",
        _ => throw new ArgumentOutOfRangeException(nameof(topic)),
    };

    public static string ManualHref(HelpTopic topic) => topic switch
    {
        HelpTopic.SeriesOrder => "manual#series",
        HelpTopic.AddBook => "manual#add-book",
        HelpTopic.BulkAdd => "manual#bulk-add",
        _ => throw new ArgumentOutOfRangeException(nameof(topic)),
    };

    private static string ManualLabel(HelpTopic topic) => topic switch
    {
        HelpTopic.SeriesOrder => "the Series section",
        HelpTopic.AddBook => "the Add book section",
        HelpTopic.BulkAdd => "the Bulk add section",
        _ => throw new ArgumentOutOfRangeException(nameof(topic)),
    };

    private static string[] Paragraphs(HelpTopic topic) => topic switch
    {
        HelpTopic.SeriesOrder =>
        [
            "The # box on each book is its position in the series. Type a whole number such as 4, or a label such as 4.5 for a novella that sits between books 4 and 5, or 1A.",
            "Books sort by the leading whole number, and the label you typed is what you see. A book labelled 4.5 sorts with book 4. Numbers below 1 are ignored, and a label with no leading number, such as II, is kept but sorts after the numbered books.",
        ],
        HelpTopic.AddBook =>
        [
            "Type an ISBN in Look up by ISBN and press Look up (or Enter) to fill the form from Open Library, then Google Books. You can edit anything before saving.",
            "If an AI provider is set up, Fill from a photo reads a photo of the cover or title page and suggests matching books. Press Use this on one, or None of these to fill the form from the photo alone. Nothing is saved until you press Save book.",
            "For an old book with no ISBN, turn on No ISBN (pre-1974 book). You then search by title and author, and press Use this on a candidate to fill the form. You still enter the format, print date and publisher yourself.",
            "For a compendium, turn on This is a collection (multiple works in one book). Each row is then one work, for example one story in an anthology.",
        ],
        HelpTopic.BulkAdd =>
        [
            "Add a pile of books by ISBN: type or paste each one into Add ISBN and press Enter, or use Scan barcode or Photo ISBN. Each ISBN becomes a row in the grid once it has been looked up.",
            "On a found row, press Accept to save it as a book, or Follow-up to save it with the follow-up tag so you can check it by hand later. Accept all saves every found row that is not already in your library.",
            "Turn on Ask AI for genres if you want the AI provider to suggest genres for a row whose lookup found none, or only top-level ones. It is off by default and greyed out when no provider is set up.",
        ],
        _ => throw new ArgumentOutOfRangeException(nameof(topic)),
    };
}
