<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- Direct pin of a transitive dependency: Microsoft.Data.SqlClient (via EF Core SqlServer) floors
         System.Security.Cryptography.Pkcs at 9.0.4, which carries GHSA-846f-f764-76mx (High) and
         GHSA-2fmv-rv2c-59x7 (Moderate); NuGet audit promotes those to errors under TreatWarningsAsErrors.
         10.0.13 is the first patched 10.x. Flows to every project that references this one. Remove the
         pin once EF Core / SqlClient resolve a patched version on their own (2026-11-14). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
